# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Qdrant Vector Database (Local: http://localhost:6333/ or Cloud: https://xyz.cloud.qdrant.io:6333)
QDRANT_URL=http://localhost:6333/
QDRANT_API_KEY=your_qdrant_cloud_api_key_if_using_cloud

# Inngest Cloud (Optional for local dev, Required for production cloud)
# Get keys from https://app.inngest.com/
INNGEST_EVENT_KEY=your_inngest_event_key_here
INNGEST_SIGNING_KEY=your_inngest_signing_key_here
INNGEST_API_BASE=http://127.0.0.1:8288/v1
# In Production, set INNGEST_API_BASE=https://api.inngest.com/v1
